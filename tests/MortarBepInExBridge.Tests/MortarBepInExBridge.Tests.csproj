<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- Tests of one game live in Games/<Name>/ and run with `-p:Game=<Name>`, the same property the plugin builds with. -->
  <ItemGroup>
    <Compile Remove="Games/**" />
    <Compile Include="Games/$(Game)/**/*.cs" Condition="'$(Game)' != ''" />
    <Compile Remove="CoreBuildTests.cs" Condition="'$(Game)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="[4.0.2]" />
    <ProjectReference Include="../../src/MortarBepInExBridge/MortarBepInExBridge.csproj" />
    <ProjectReference Include="../../src/MortarBepInExBridge.Patcher/MortarBepInExBridge.Patcher.csproj">
      <Aliases>Patcher</Aliases>
    </ProjectReference>
  </ItemGroup>
</Project>
