# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

[*.sh]
indent_size = 2

# Trailing double spaces are hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false

# Newest C# idioms are build errors (EnforceCodeStyleInBuild with TreatWarningsAsErrors).
[*.cs]
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0090.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
dotnet_diagnostic.IDE0290.severity = warning
dotnet_diagnostic.IDE0057.severity = warning
