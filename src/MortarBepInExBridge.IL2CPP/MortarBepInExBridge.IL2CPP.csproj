<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MortarBepInExBridge.IL2CPP</AssemblyName>
    <RootNamespace>MortarBepInExBridge</RootNamespace>
    <Version>0.4.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- The game-agnostic code is the BepInEx 5 project's own files, compiled in here rather than copied. -->
  <ItemGroup>
    <Compile Include="../MortarBepInExBridge/Protocol.cs" Link="Shared/Protocol.cs" />
    <Compile Include="../MortarBepInExBridge/BridgeServer.cs" Link="Shared/BridgeServer.cs" />
    <Compile Include="../MortarBepInExBridge/Files.cs" Link="Shared/Files.cs" />
    <Compile Include="../MortarBepInExBridge/Json.cs" Link="Shared/Json.cs" />
    <Compile Include="../MortarBepInExBridge/LogTag.cs" Link="Shared/LogTag.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.793" PrivateAssets="all" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
